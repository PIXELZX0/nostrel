# --- basics ---
RELAY_PORT=3334
DB_PATH=./nostrel.db
# The URL people open in a browser. NIP-98 admin logins are checked against it,
# so it must match exactly (scheme + host, no trailing slash).
PANEL_URL=https://relay.example.com
# Public websocket address of the relay, advertised to clients.
SERVICE_URL=wss://relay.example.com

RELAY_NAME=my paid relay
RELAY_DESCRIPTION=paid whitelist relay
RELAY_CONTACT=mailto:admin@example.com
RELAY_PUBKEY=
RELAY_ICON=

# NIP-43 초대 코드. 릴레이가 자기 이름으로 서명할 개인키(hex 64자).
# 없으면 NIP-43 전체가 꺼지고 supported_nips에도 43이 올라가지 않는다.
# 생성: openssl rand -hex 32
# 유출되면 남이 이 릴레이 이름으로 멤버십 목록을 위조할 수 있다.
RELAY_SECRET_KEY=

# --- admin access ---
# Comma separated hex pubkeys allowed into the panel and the NIP-86 API.
ADMIN_PUBKEYS=
# Fallback login. Generate with: nostrel hash-password 'your password'
ADMIN_PASSWORD_HASH=
# Random string; without it password sessions are dropped on every restart.
SESSION_SECRET=

# --- payments ---
# These seed the database on the very first start. After that the admin panel
# owns the lightning backend and changing these has no effect.
# lnbits | nwc | mock   (mock settles invoices by itself: local testing only)
PAYMENT_PROVIDER=lnbits
LNBITS_URL=https://lnbits.example.com
LNBITS_INVOICE_KEY=
# NWC_URI=nostr+walletconnect://<wallet-pubkey>?relay=wss://relay.getalby.com/v1&secret=<hex>

# --- policy ---
# true = readers must authenticate (NIP-42) and be whitelisted too
READ_AUTH_REQUIRED=false
# NIP-13: minimum committed proof-of-work difficulty. 0 disables it.
MIN_POW=0
# created_at limits in seconds (0 = unbounded), advertised through NIP-11
CREATED_AT_MAX_PAST=0
CREATED_AT_MAX_FUTURE=900

# --- media (Blossom + NIP-96) ---
# Seeds the storage backend on the first start; the admin panel owns it after
# that (including the S3 credentials, which are never put in the environment).
# local | s3
BLOB_BACKEND=local
BLOB_PATH=./blobs
MAX_BLOB_SIZE_MB=25
